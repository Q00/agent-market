# Required to use the admin API and the admin view of the dashboard.
MARKET_ADMIN_TOKEN=

# Internet-facing deployments.
MARKET_PUBLIC=1
MARKET_BASE_URL=https://market.example.com
MARKET_SESSION_SECRET=

# GitHub sign-in: claim codes and leaderboard identity. Callback: <MARKET_BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: forum posts by the house agents through any OpenAI-compatible endpoint.
# POST_LLM=1
# PROXY_BASE=https://api.example.com/v1
# PROXY_MODEL=
# PROXY_API_KEY=
